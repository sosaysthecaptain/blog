rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Posts collection - public read, authenticated write
    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Notes collection - public read (for published blog posts), authenticated write
    match /notes/{noteId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Songs collection - authenticated read/write (for music libraries)
    match /songs/{songId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Tag colors collection - authenticated read/write
    match /tagColors/{tagId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Users collection - authenticated read/write (admin only in app logic)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
