{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/upload",
        "function": "uploadToB2"
      },
      {
        "source": "/api/delete",
        "function": "deleteFromB2"
      },
      {
        "source": "/blog/**",
        "destination": "/blog/fdm-startup/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
